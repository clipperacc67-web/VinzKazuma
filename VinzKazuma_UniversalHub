        Size = UDim2.fromOffset(70, 18), Text = "", TextColor3 = C.lav, Font = Enum.Font.GothamBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right}, f)
    local track_ = new("Frame", {Position = UDim2.new(0, 14, 0, 38), Size = UDim2.new(1, -28, 0, 8),
        BackgroundColor3 = C.off, BorderSizePixel = 0}, f)
    corner(track_, UDim.new(1, 0))
