            if not (my and th) then if ftTog then ftTog.Set(false) end return end
            if os.clock() - FT.t0 > 10 or th.AssemblyLinearVelocity.Magnitude > 300
                or (FT.start and (th.Position - FT.start).Magnitude > 250) then
                if ftTog then ftTog.Set(false) end
                notify("Target flung / timeout")
                return
            end
            my.CFrame = th.CFrame + th.AssemblyLinearVelocity * 0.1
        end
        if S.spectate then
            local h = humOf(S.selected)
            if h then
                if Camera.CameraSubject ~= h then Camera.CameraSubject = h end
            elseif specTog then
                specTog.Set(false)
            end
        end
    end))
    onUnload(function()
        if S.ftarget then F.ftStop() end
        local h = humOf(LP)
        if h and Camera then Camera.CameraSubject = h end
    end)
end

F.teleportTo = function()
    local my, th = hrpOf(LP), hrpOf(S.selected)
    if not S.selected then notify("Pick a player first") return end
    if my and th then my.CFrame = th.CFrame * CFrame.new(0, 0, 3) else notify("Target unavailable") end
end

-- ---------- freecam
do
    local FC = {yaw = 0, pitch = 0, pos = Vector3.zero, anch = nil}
    F.fcStart = function()
        local hrp = hrpOf(LP)
        if not hrp then return false end
        FC.anch = hrp.Anchored
        hrp.Anchored = true
        local cf = Camera.CFrame
        local rx, ry = cf:ToOrientation()
        FC.pitch, FC.yaw, FC.pos = rx, ry, cf.Position
        Camera.CameraType = Enum.CameraType.Scriptable
        return true
    end
    F.fcStop = function()
        local hrp = hrpOf(LP)
        if hrp and FC.anch ~= nil then hrp.Anchored = FC.anch end
        FC.anch = nil
        Camera.CameraType = Enum.CameraType.Custom
        local h = humOf(LP)
        if h then Camera.CameraSubject = h end
    end
    onUnload(function() if S.freecam then F.fcStop() end end)

    track(UIS.InputChanged:Connect(function(input, gp)
        if not S.freecam then return end
        local look = false
        if input.UserInputType == Enum.UserInputType.Touch and not gp then look = true
        elseif input.UserInputType == Enum.UserInputType.MouseMovement
            and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then look = true end
        if look then
            FC.yaw -= input.Delta.X * 0.006
            FC.pitch = math.clamp(FC.pitch - input.Delta.Y * 0.006, -1.5, 1.5)
        end
    end))

    pcall(function() RunService:UnbindFromRenderStep("VK_Cam") end)
    RunService:BindToRenderStep("VK_Cam", Enum.RenderPriority.Camera.Value + 2, function(dt)
        if not S.freecam then return end
        local rot = CFrame.fromOrientation(FC.pitch, FC.yaw, 0)
        local hum = humOf(LP)
        local md = hum and hum.MoveDirection or Vector3.zero
        local look, right = rot.LookVector, rot.RightVector
        local fl = Vector3.new(look.X, 0, look.Z)
        fl = fl.Magnitude > 1e-3 and fl.Unit or Vector3.new(0, 0, -1)
        local fr = Vector3.new(right.X, 0, right.Z)
        fr = fr.Magnitude > 1e-3 and fr.Unit or Vector3.new(1, 0, 0)
        local vel = look * md:Dot(fl) + right * md:Dot(fr)
        if (hum and hum.Jump) or UIS:IsKeyDown(Enum.KeyCode.E) then vel += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) then vel -= Vector3.new(0, 1, 0) end
        if vel.Magnitude > 1 then vel = vel.Unit end
        FC.pos += vel * S.camSpd * dt
        Camera.CFrame = CFrame.new(FC.pos) * rot
    end)
end

-- ---------- RTX / HD shader
do
    local MaterialService = game:GetService("MaterialService")
    local RTX = {bk = nil, parts = setmetatable({}, {__mode = "k"}), wet = setmetatable({}, {__mode = "k"}),
        queue = {}, gen = 0, fx = {}, conn = nil, dirty = false, myPos = Vector3.zero}
    local LPROPS = {"Brightness", "ClockTime", "GlobalShadows", "ShadowSoftness", "EnvironmentDiffuseScale",
        "EnvironmentSpecularScale", "ExposureCompensation", "Technology"}
    local TPROPS = {"WaterReflectance", "WaterTransparency", "WaterWaveSize", "WaterWaveSpeed", "WaterColor", "Decoration"}
    local WETTERRAIN = {"Grass", "LeafyGrass", "Ground", "Sand", "Mud", "Rock", "Pavement", "Asphalt", "Concrete",
        "Cobblestone", "Slate", "Basalt", "Sandstone"}

    local function matSet(names)
        local s = {}
        for _, n in ipairs(names) do
            local ok, m = pcall(function() return Enum.Material[n] end)
            if ok and m then s[m] = true end
        end
        return s
    end
    local NATURAL = matSet({"Grass", "LeafyGrass", "Ground", "Mud", "Sand", "Snow", "Sandstone", "Rock", "Salt", "Basalt",
        "Fabric", "Foil", "Neon", "ForceField", "CrackedLava", "Glacier"})
    local HARD = matSet({"Concrete", "Brick", "Cobblestone", "Pavement", "Asphalt", "Slate", "Granite", "Marble", "Metal",
        "CorrodedMetal", "DiamondPlate", "WoodPlanks", "Wood", "Limestone", "Pebble", "Ice", "SmoothPlastic", "Plastic"})

    local function pickMat(p)
        local h, s, v = p.Color:ToHSV()
        local sz = p.Size
        local floor = sz.Y < math.min(sz.X, sz.Z) * 0.6 and sz.X * sz.Z > 120
        if s < 0.16 then
            if v > 0.78 then return Enum.Material.Marble, floor and 0.14 or 0.08
            elseif v > 0.5 then return Enum.Material.Metal, 0.18
            elseif v > 0.25 then return Enum.Material.Concrete, floor and 0.08 or 0
            else return Enum.Material.Slate, floor and 0.1 or 0 end
        elseif h >= 0.03 and h <= 0.13 and v < 0.8 then
            return Enum.Material.WoodPlanks, 0
        elseif s < 0.55 then
            return Enum.Material.Concrete, floor and 0.08 or 0
        end
        return Enum.Material.SmoothPlastic, 0.05
    end

    local function isFloor(p)
        local sz = p.Size
        return p.CFrame.UpVector.Y > 0.9 and sz.X * sz.Z >= 24 and sz.Y <= math.max(sz.X, sz.Z) * 0.8
    end

    local function process(d, myPos)
        if RTX.parts[d] or not d:IsA("BasePart") or d:IsA("Terrain") then return end
        if d.Transparency >= 1 or isCharPart(d) then return end
        if d:FindFirstChildOfClass("SurfaceAppearance") then return end
        local m0, t = d.Material, d.Transparency
        local plastic = m0 == Enum.Material.Plastic or m0 == Enum.Material.SmoothPlastic
        local mt, base, fac, dark = nil, 0, 0, 0
        if m0 == Enum.Material.Water then
            base = 0.5
        elseif m0 == Enum.Material.Glass or (plastic and t >= 0.25) then
            local c = d.Color
            local bluish = c.B > c.R * 1.15 and c.B >= c.G * 0.85
            if plastic then mt = Enum.Material.Glass end
            base = bluish and 0.55 or 0.32
        else
            if plastic then mt, base = pickMat(d) end
            base = base or 0
            local fm = mt or m0
            if isFloor(d) and not NATURAL[m0] then
                fac, dark = 0.45, 0.2
            elseif HARD[fm] then
                fac, dark = 0.12, 0.08
            end
        end
        if not mt and base == 0 and fac == 0 then return end

        local o = {Mat = m0, Rf = d.Reflectance, Col = d.Color}
        local isMesh = d:IsA("MeshPart")
        if isMesh then o.Fid = d.RenderFidelity end
        RTX.parts[d] = o
        base = math.max(base, o.Rf)
        pcall(function()
            if mt then d.Material = mt end
            d.Reflectance = math.max(base, fac * S.rtxWet)
            if fac > 0 then
                RTX.wet[d] = {base = base, fac = fac, dark = dark, col = o.Col}
                d.Color = o.Col:Lerp(Color3.new(0, 0, 0), dark * S.rtxWet)
            end
            if isMesh and (d.Position - myPos).Magnitude < 150 then
                d.RenderFidelity = Enum.RenderFidelity.Precise
            end
        end)
    end

    local function overhaul(gen)
        local n = 0
        local myPos = RTX.myPos
        for _, d in ipairs(Workspace:GetDescendants()) do
            if RTX.gen ~= gen or not Alive then return end
            n += 1
            if n % 250 == 0 then task.wait() end
            pcall(process, d, myPos)
        end
    end

    local function wetTerrain()
        local bk = RTX.bk
        if not bk then return end
        local T = Workspace.Terrain
        for _, n in ipairs(WETTERRAIN) do
            local ok, m = pcall(function() return Enum.Material[n] end)
            if ok and m then
                if not bk.tc[n] then
                    local ok2, c = pcall(function() return T:GetMaterialColor(m) end)
                    if ok2 then bk.tc[n] = c end
                end
                local base = bk.tc[n]
                if base then
                    pcall(function() T:SetMaterialColor(m, base:Lerp(Color3.new(0, 0, 0), S.rtxWet * 0.3)) end)
                end
            end
        end
    end

    local function applyWet(gen)
        wetTerrain()
        local list = {}
        for p in pairs(RTX.wet) do list[#list + 1] = p end
        local w = S.rtxWet
        for i, p in ipairs(list) do
            if RTX.gen ~= gen or not Alive then return end
            local wd = RTX.wet[p]
            if p.Parent and wd then
                pcall(function()
                    p.Reflectance = math.max(wd.base, wd.fac * w)
                    p.Color = wd.col:Lerp(Color3.new(0, 0, 0), wd.dark * w)
                end)
            end
            if i % 300 == 0 then task.wait() end
        end
    end

    local function applyLight()
        if not RTX.bk then return end
        local e, w = S.rtxExp, S.rtxWet
        setProp(Lighting, "Brightness", e * 1.7)
        setProp(Lighting, "ExposureCompensation", (e - 1.15) * 0.5)
        setProp(Lighting, "ClockTime", S.rtxTime)
        if RTX.fx.cc then RTX.fx.cc.Brightness = (e - 1.15) * 0.05 end
        local at = RTX.fx.atmo or (RTX.bk.atmo and RTX.bk.atmo.inst)
        if at then pcall(function() at.Haze = 0.6 + w * 1.2 end) end
        if RTX.fx.clouds then pcall(function() RTX.fx.clouds.Cover = 0.3 + w * 0.4 end) end
        RTX.dirty = true
    end
    F.rtxApply = applyLight

    local function restoreParts(gen, sync)
        local list = {}
        for p in pairs(RTX.parts) do list[#list + 1] = p end
        for i, p in ipairs(list) do
            if not sync and (RTX.gen ~= gen or not Alive) then return end
            local o = RTX.parts[p]
            if p.Parent and o then
                pcall(function()
                    p.Material = o.Mat
                    p.Reflectance = o.Rf
                    p.Color = o.Col
                    if o.Fid then p.RenderFidelity = o.Fid end
                end)
            end
            RTX.parts[p] = nil
            if not sync and i % 250 == 0 then task.wait() end
        end
    end

    local function enable()
        if RTX.bk then return end
        local T = Workspace.Terrain
        local bk = {L = {}, T = {}, tc = {}, atmo = nil}
        for _, p in ipairs(LPROPS) do bk.L[p] = getProp(Lighting, p) end
        for _, p in ipairs(TPROPS) do bk.T[p] = getProp(T, p) end
        pcall(function() bk.q = settings().Rendering.QualityLevel end)
        pcall(function() bk.md = settings().Rendering.MeshPartDetailLevel end)
        bk.ms = getProp(MaterialService, "Use2022Materials")
        RTX.bk = bk

        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level21 end)
        pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04 end)
        setProp(MaterialService, "Use2022Materials", true)

        setProp(Lighting, "Technology", Enum.Technology.Future)
        setProp(Lighting, "GlobalShadows", true)
        setProp(Lighting, "ShadowSoftness", 0.12)
        setProp(Lighting, "EnvironmentDiffuseScale", 1)
        setProp(Lighting, "EnvironmentSpecularScale", 1)

        RTX.fx.cc = new("ColorCorrectionEffect", {Name = "VK_CC", Contrast = 0.2, Saturation = 0.2,
            TintColor = Color3.fromRGB(236, 243, 255), Brightness = 0}, Lighting)
        RTX.fx.bloom = new("BloomEffect", {Name = "VK_Bloom", Intensity = 0.35, Threshold = 1.5, Size = 28}, Lighting)
        RTX.fx.sun = new("SunRaysEffect", {Name = "VK_Sun", Intensity = 0.06, Spread = 0.6}, Lighting)

        local existing = Lighting:FindFirstChildOfClass("Atmosphere")
        if existing then
            bk.atmo = {inst = existing, Density = existing.Density, Glare = existing.Glare, Haze = existing.Haze}
            existing.Density, existing.Glare, existing.Haze = 0.32, 0, 1.2
        else
            RTX.fx.atmo = new("Atmosphere", {Name = "VK_Atmosphere", Density = 0.32, Glare = 0, Haze = 1.2}, Lighting)
        end
        if not T:FindFirstChildOfClass("Clouds") then
            RTX.fx.clouds = new("Clouds", {Name = "VK_Clouds", Cover = 0.55, Density = 0.55,
                Color = Color3.fromRGB(205, 211, 225)}, T)
        end

        setProp(T, "WaterReflectance", 1)
        setProp(T, "WaterTransparency", 0.85)
        setProp(T, "WaterWaveSize", 0.15)
        setProp(T, "WaterWaveSpeed", 10)
        setProp(T, "WaterColor", Color3.fromRGB(22, 96, 140))
        setProp(T, "Decoration", true)

        RTX.myPos = (hrpOf(LP) and hrpOf(LP).Position) or Camera.CFrame.Position
        RTX.queue = {}
        RTX.gen += 1
        local gen = RTX.gen
        RTX.conn = Workspace.DescendantAdded:Connect(function(d)
            if #RTX.queue < 4000 and d:IsA("BasePart") then RTX.queue[#RTX.queue + 1] = d end
        end)
        applyLight()
        task.spawn(function()
            pcall(overhaul, gen)
            while RTX.gen == gen and Alive do
                local q, n = RTX.queue, 0
                while #q > 0 and n < 80 do
                    local d = table.remove(q)
                    n += 1
                    if d.Parent then pcall(process, d, RTX.myPos) end
                end
                if RTX.dirty then
                    RTX.dirty = false
                    pcall(applyWet, gen)
                end
                task.wait(0.25)
            end
        end)
    end

    local function disable(sync)
        local bk = RTX.bk
        if not bk then return end
        RTX.bk = nil
        RTX.gen += 1
        local gen = RTX.gen
        if RTX.conn then RTX.conn:Disconnect() RTX.conn = nil end
        RTX.queue = {}
        RTX.wet = setmetatable({}, {__mode = "k"})
        for p, v in pairs(bk.L) do if v ~= nil then setProp(Lighting, p, v) end end
        for p, v in pairs(bk.T) do if v ~= nil then setProp(Workspace.Terrain, p, v) end end
        for n, c in pairs(bk.tc) do
            pcall(function() Workspace.Terrain:SetMaterialColor(Enum.Material[n], c) end)
        end
        if bk.q then pcall(function() settings().Rendering.QualityLevel = bk.q end) end
        if bk.md then pcall(function() settings().Rendering.MeshPartDetailLevel = bk.md end) end
        if bk.ms ~= nil then setProp(MaterialService, "Use2022Materials", bk.ms) end
        for k, inst in pairs(RTX.fx) do pcall(function() inst:Destroy() end) RTX.fx[k] = nil end
        if bk.atmo and bk.atmo.inst and bk.atmo.inst.Parent then
            bk.atmo.inst.Density, bk.atmo.inst.Glare, bk.atmo.inst.Haze = bk.atmo.Density, bk.atmo.Glare, bk.atmo.Haze
        end
        if sync then restoreParts(gen, true) else task.spawn(function() restoreParts(gen, false) end) end
    end

    F.rtxToggle = function(v) if v then enable() else disable(false) end end
    onUnload(function() disable(true) end)
end

-- ---------- ESP
do
    local objs = {}
    local function clear(p)
        local o = objs[p]
        if o then
            for _, k in ipairs({"hl", "bb", "line"}) do if o[k] then pcall(function() o[k]:Destroy() end) end end
            objs[p] = nil
        end
    end
    local function clearAll() for p in pairs(objs) do clear(p) end end
    F.espClear = clearAll
    onUnload(clearAll)
    track(Players.PlayerRemoving:Connect(clear))

    local function build(p)
        local ch = p.Character
        if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        local hum = ch:FindFirstChildOfClass("Humanoid")
        local head = ch:FindFirstChild("Head") or hrp
        if not (hrp and hum and head) then return end
        local o = {char = ch, hrp = hrp, hum = hum}
        o.hl = new("Highlight", {Adornee = ch, FillColor = C.neon, OutlineColor = C.lav, FillTransparency = 0.82,
            OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false}, EspFolder)
        o.bb = new("BillboardGui", {Adornee = head, AlwaysOnTop = true, Size = UDim2.fromOffset(140, 40),
            StudsOffset = Vector3.new(0, 2.6, 0), LightInfluence = 0, ResetOnSpawn = false, Enabled = false}, EspFolder)
        o.name = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Text = p.DisplayName,
            TextColor3 = C.txt, Font = Enum.Font.GothamBold, TextSize = 13, TextStrokeTransparency = 0.4,
            TextStrokeColor3 = Color3.new(0, 0, 0)}, o.bb)
        o.hpBg = new("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24),
            Size = UDim2.fromOffset(90, 6), BackgroundColor3 = C.card, BorderSizePixel = 0}, o.bb)
        corner(o.hpBg, UDim.new(1, 0))
        stroke(o.hpBg, C.lav, 1, 0.4)
        o.hpFill = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(80, 220, 120),
            BorderSizePixel = 0}, o.hpBg)
        corner(o.hpFill, UDim.new(1, 0))
        o.line = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = C.lav, BorderSizePixel = 0,
            Visible = false, Size = UDim2.fromOffset(0, 1.5)}, Tracers)
        objs[p] = o
    end

    track(RunService.RenderStepped:Connect(function()
        if not S.esp then return end
        local my = hrpOf(LP)
        local vp = Camera.ViewportSize
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local o = objs[p]
                local ch = p.Character
                if ch and (not o or o.char ~= ch or not o.hrp.Parent) then
                    clear(p)
                    build(p)
                    o = objs[p]
                end
                if o and o.hum.Health > 0 then
                    o.hl.Enabled = S.espBox
                    o.bb.Enabled = S.espName or S.espHp
                    o.name.Visible = S.espName
                    o.hpBg.Visible = S.espHp
                    if S.espName then
                        local dist = my and math.floor((o.hrp.Position - my.Position).Magnitude) or 0
                        o.name.Text = string.format("%s [%d studs]", p.DisplayName, dist)
                    end
                    if S.espHp then
                        local ratio = math.clamp(o.hum.Health / math.max(o.hum.MaxHealth, 1), 0, 1)
                        o.hpFill.Size = UDim2.fromScale(ratio, 1)
                        o.hpFill.BackgroundColor3 = Color3.fromRGB(235, 70, 80):Lerp(Color3.fromRGB(80, 220, 120), ratio)
                    end
                    if S.espTracer then
                        local sp, on = Camera:WorldToViewportPoint(o.hrp.Position)
                        if on then
                            local a, b = Vector2.new(vp.X / 2, vp.Y), Vector2.new(sp.X, sp.Y)
                            local d = b - a
                            o.line.Size = UDim2.fromOffset(d.Magnitude, 1.5)
                            o.line.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
                            o.line.Rotation = math.deg(math.atan2(d.Y, d.X))
                            o.line.Visible = true
                        else
                            o.line.Visible = false
                        end
                    else
                        o.line.Visible = false
                    end
                elseif o then
                    o.hl.Enabled, o.bb.Enabled, o.line.Visible = false, false, false
                end
            end
        end
    end))
end

-- ---------- x-ray
do
    local XR = {set = setmetatable({}, {__mode = "k"}), gen = 0, dirty = false}
    local function scan(gen)
        local n = 0
        for _, d in ipairs(Workspace:GetDescendants()) do
            if XR.gen ~= gen or not Alive then return end
            n += 1
            if n % 300 == 0 then task.wait() end
            if d:IsA("BasePart") and not d:IsA("Terrain") and not isCharPart(d) then
                XR.set[d] = true
                d.LocalTransparencyModifier = S.xrayT
            end
        end
    end
    local function setAll(val)
        local n = 0
        for p in pairs(XR.set) do
            if p.Parent then pcall(function() p.LocalTransparencyModifier = val end) end
            n += 1
            if val ~= 0 and n % 400 == 0 then task.wait() end
        end
    end
    F.xrayToggle = function(v)
        XR.gen += 1
        if v then XR.dirty = false else setAll(0) end
    end
    F.xrayDirty = function() XR.dirty = true end
    onUnload(function() XR.gen += 1 for p in pairs(XR.set) do pcall(function() p.LocalTransparencyModifier = 0 end) end end)

    task.spawn(function()
        local lastScan = 0
        while Alive do
            task.wait(0.3)
            if S.xray then
                if os.clock() - lastScan > 8 then
                    lastScan = os.clock()
                    XR.dirty = false
                    pcall(scan, XR.gen)
                elseif XR.dirty then
                    XR.dirty = false
                    pcall(setAll, S.xrayT)
                end
            else
                lastScan = 0
            end
        end
    end)
end

