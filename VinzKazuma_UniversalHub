local function new(class, props, parent)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r) return new("UICorner", {CornerRadius = r or UDim.new(0, 8)}, o) end
local function stroke(o, col, th, tr)
    return new("UIStroke", {Color = col, Thickness = th or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end
local function grad(o, c0, c1, rot)
    return new("UIGradient", {Color = ColorSequence.new(c0, c1), Rotation = rot or 0}, o)
end
local function tw(o, t, props, style, dir)
    local tween = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

local function setProp(inst, prop, val)
    local ok = pcall(function() inst[prop] = val end)
    if not ok and sethiddenproperty then pcall(sethiddenproperty, inst, prop, val) end
end
local function getProp(inst, prop)
    local ok, v = pcall(function() return inst[prop] end)
    if ok then return v end
    if gethiddenproperty then
        local ok2, v2 = pcall(gethiddenproperty, inst, prop)
        if ok2 then return v2 end
    end
    return nil
end

