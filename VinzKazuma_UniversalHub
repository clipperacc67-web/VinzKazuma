-- ---------- player immune (client-side: health lock, no death/ragdoll states, blocks local damage calls)
do
    local IM = {hum = nil, char = nil, bj = nil, hc = nil}
    local LOCK = {Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll}

    local function setStates(hum, on)
        for _, st in ipairs(LOCK) do pcall(function() hum:SetStateEnabled(st, on) end) end
    end
    local function release()
        if IM.hc then IM.hc:Disconnect() IM.hc = nil end
        local hum = IM.hum
        if hum and hum.Parent then
            setStates(hum, true)
            if IM.bj ~= nil then pcall(function() hum.BreakJointsOnDeath = IM.bj end) end
        end
        IM.hum, IM.char, IM.bj = nil, nil, nil
    end
    F.immuneToggle = function(v) if not v then release() end end
    onUnload(release)

    track(RunService.Heartbeat:Connect(function()
        if not S.immune then return end
        local hum = humOf(LP)
        if not hum then return end
        if hum ~= IM.hum then
            if IM.hc then IM.hc:Disconnect() IM.hc = nil end
            IM.hum, IM.char, IM.bj = hum, LP.Character, hum.BreakJointsOnDeath
            setStates(hum, false)
            pcall(function() hum.BreakJointsOnDeath = false end)
            IM.hc = hum.HealthChanged:Connect(function(h)
                if S.immune and h < hum.MaxHealth then pcall(function() hum.Health = hum.MaxHealth end) end
            end)
        end
        if hum.Health < hum.MaxHealth then pcall(function() hum.Health = hum.MaxHealth end) end
    end))

    if hookmetamethod and getnamecallmethod and checkcaller then
        pcall(function()
            local old
            local function hook(self, ...)
                local m = getnamecallmethod()
                if Alive and S.immune and (self == IM.hum or self == IM.char) and not checkcaller() then
                    if m == "TakeDamage" or m == "BreakJoints" then return end
                    if m == "ChangeState" and (...) == Enum.HumanoidStateType.Dead then return end
                end
                return old(self, ...)
            end
            old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)
        end)
    end
end

