    stroke(listBox, C.lav, 1, 0.8)
    new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3)}, listBox)
    new("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 6)}, listBox)

    local function others()
        local l = {}
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP then l[#l + 1] = pl end
        end
        table.sort(l, function(a, b) return a.Name:lower() < b.Name:lower() end)
        return l
    end
    local function setSelected(pl)
        S.selected = pl
        selBtn.Text = pl and (pl.DisplayName .. " (@" .. pl.Name .. ")  v") or "Select player  v"
    end
    local function paint()
        local sel = S.selected and S.selected.Name or ""
        for _, b in ipairs(listBox:GetChildren()) do
            if b:IsA("TextButton") then b.BackgroundColor3 = (b.Name == sel) and C.violet or C.bg end
        end
    end
    local function choose(pl)
        if S.selected ~= pl then
            if S.spectate and specTog then specTog.Set(false) end
            if S.ftarget and ftTog then ftTog.Set(false) end
        end
        setSelected(pl)
        paint()
    end
    local function refresh()
        for _, c in ipairs(listBox:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        if S.selected and S.selected.Parent ~= Players then
            if S.spectate and specTog then specTog.Set(false) end
            if S.ftarget and ftTog then ftTog.Set(false) end
            setSelected(nil)
        end
        for i, pl in ipairs(others()) do
            local b = new("TextButton", {Name = pl.Name, Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = C.bg, BorderSizePixel = 0,
                Text = pl.DisplayName .. "  (@" .. pl.Name .. ")", TextColor3 = C.txt, Font = Enum.Font.GothamMedium,
                TextSize = 11, AutoButtonColor = false, LayoutOrder = i, TextTruncate = Enum.TextTruncate.AtEnd}, listBox)
            corner(b, UDim.new(0, 6))
            b.Activated:Connect(function()
                F.sfx()
                choose(pl)
                listBox.Visible = false
            end)
        end
        paint()
    end
    local function cycle(d)
        local l = others()
        if #l == 0 then notify("No other players") return end
        local idx = 0
        for i, pl in ipairs(l) do
            if pl == S.selected then idx = i end
        end
        if idx == 0 then idx = d > 0 and 0 or 1 end
        choose(l[((idx - 1 + d) % #l) + 1])
    end
    prevB.Activated:Connect(function() F.sfx() cycle(-1) end)
    nextB.Activated:Connect(function() F.sfx() cycle(1) end)
    selBtn.Activated:Connect(function()
        F.sfx()
        listBox.Visible = not listBox.Visible
        if listBox.Visible then refresh() end
    end)

    Section(p, "Actions on selected")
    Button(p, "Teleport to Player", function() F.teleportTo() end)
    specTog = Toggle(p, "Spectate Player", "spectate", function(v)
        if v then
            local h = humOf(S.selected)
            if h then Camera.CameraSubject = h
            else notify("Pick a player first") specTog.Set(false) end
        else
            local h = humOf(LP)
            if h then Camera.CameraSubject = h end
        end
    end)
    ftTog = Toggle(p, "Fling Target", "ftarget", function(v)
        if v then
            if not F.ftStart() then notify("Pick a living player first") ftTog.Set(false) end
        else
            F.ftStop()
        end
    end)

    Section(p, "Freecam")
    fcTog = Toggle(p, "Analog Freecam", "freecam", function(v)
        if v then
            if not F.fcStart() then notify("Character not ready") fcTog.Set(false) end
        else
            F.fcStop()
        end
    end)
    Slider(p, "Cam Speed", "camSpd", 10, 200, 1)

    track(Players.PlayerAdded:Connect(function() task.defer(refresh) end))
    track(Players.PlayerRemoving:Connect(function() task.delay(0.2, function() if Alive then refresh() end end) end))
    task.spawn(function()
        while Alive do
            refresh()
            task.wait(10)
        end
    end)
end

