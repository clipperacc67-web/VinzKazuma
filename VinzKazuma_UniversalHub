-- ============================================================ intro (~5s, busy: streaks, bursts, orbit, glitch, typewriter)
local function runIntro()
    F.sfxWait(1.5)
    local vp = Camera.ViewportSize
    local rnd = math.random
    local big = math.max(vp.X, vp.Y)
    local ov = new("Frame", {Name = "Intro", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg, BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 100, Active = true}, Gui)
    tw(ov, 0.4, {BackgroundTransparency = 0.02})

    -- rich layered cyber soundscape (100% non-vocal): synced to every visual beat with DSP + pitch sweeps
    local function hit(id, sp, vol, opts) if ov.Parent then F.introSfx(id, sp, vol, opts) end end
    local function semi(n) return 2 ^ (n / 12) end
    local function subDrop(vol, spd)
        local s = spd or 0.3
        hit("whoosh", s, vol or 0.9, {fx = "sub", toSpeed = s * 0.65, dur = 0.6})
        hit("click", s * 0.95, (vol or 0.9) * 0.85, {fx = "sub"})
    end
    local function errBuzz(vol, base)
        local b = base or 0.42
        hit("ping", b, vol or 0.55, {fx = "err"})
        hit("ping", b * 0.92, (vol or 0.55) * 0.85, {fx = "err"}) -- dissonant cyber system error buzz
    end

    -- 0.0s: cinematic ignition — deep sub swell + wide cyber synth pad + metallic blade draw
    subDrop(0.85, 0.34)
    hit("intro", 0.85, 0.65, {fx = "space"})
    hit("intro", 0.85 * semi(7), 0.38, {fx = "space"})
    hit("shing", 0.95, 0.55, {fx = "shimmer"})

    -- 0.2s -> 1.1s: twin blade fly-in whooshes + clean sci-fi turbine energy riser
    task.delay(0.18, function()
        hit("lunge", 0.52, 0.75, {fx = "whoosh", toSpeed = 1.85, dur = 0.88, style = Enum.EasingStyle.Exponential, dir = Enum.EasingDirection.In})
        hit("ping", 0.55, 0.35, {fx = "whoosh", toSpeed = 2.1, dur = 0.88, style = Enum.EasingStyle.Exponential, dir = Enum.EasingDirection.In})
        task.delay(0.15, function()
            hit("whoosh", 0.8, 0.65, {fx = "whoosh", toSpeed = 1.9, dur = 0.7})
        end)
    end)
    for k = 1, 14 do -- accelerating synth arpeggio build-up toward the 1.1s impact drop
        local u = k / 14
        local t = 0.22 + 0.84 * (1 - (1 - u) ^ 2.15)
        local scaleNotes = {0, 3, 5, 7, 10, 12, 15, 17, 19, 22, 24, 27, 29, 31}
        task.delay(t, function()
            local p = math.min(3.2, 0.75 * semi(scaleNotes[k] or 0))
            hit("ping", p, 0.22 + 0.34 * u, {fx = (k % 2 == 0) and "echo" or "shimmer"})
            if k >= 9 then
                hit("spark", 1.1 + 1.2 * u, 0.28 + 0.25 * u, {fx = "punch"})
            end
        end)
    end

    local stageScale = math.clamp(math.min(vp.X / 460, vp.Y / 400), 0.5, 1)
    local stage = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(420, 340), BackgroundTransparency = 1, ZIndex = 101}, ov)
    new("UIScale", {Scale = stageScale}, stage)

    local logo = new("Frame", {Name = "Logo", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 120),
        Size = UDim2.fromOffset(100, 100), BackgroundTransparency = 1, ZIndex = 105}, stage)
    local lscale = new("UIScale", {Scale = 1}, logo)
    local aura = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(170, 170), BackgroundTransparency = 1, ZIndex = 104}, logo)
    corner(aura, UDim.new(1, 0))
    local auraStroke = stroke(aura, C.lav, 5, 1)
    local auraGrad = grad(auraStroke, C.violet, C.mag, 0)
    local aura2 = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(215, 215), BackgroundTransparency = 1, ZIndex = 104}, logo)
    corner(aura2, UDim.new(1, 0))
    local aura2Stroke = stroke(aura2, C.txt, 2, 1)
    local aura2Grad = grad(aura2Stroke, C.lav, C.mag, 0)

    local L, R = makeV(logo, 100, 106)
    local lp, lr, rp, rr = L.Position, L.Rotation, R.Position, R.Rotation
    L.Position = UDim2.new(0.5, -vp.X * 0.6, 0.5, -vp.Y * 0.5)
    R.Position = UDim2.new(0.5, vp.X * 0.6, 0.5, vp.Y * 0.5)
    L.Rotation = lr - 180
    R.Rotation = rr - 180

    local function lcenter()
        local c = logo.AbsolutePosition + logo.AbsoluteSize / 2
        if c.X == 0 and c.Y == 0 then return Vector2.new(vp.X / 2, vp.Y / 2) end
        return c
    end

    local function ring(delay, maxSize)
        task.delay(delay, function()
            if not ov.Parent then return end
            local c = lcenter()
            local heavy = maxSize > big * 0.8
            hit("whoosh", heavy and 0.58 or 0.88, heavy and 0.72 or 0.55, {fx = "whoosh", toSpeed = heavy and 1.25 or 1.6, dur = 0.55})
            hit("ping", heavy and 0.65 or 1.15, 0.42, {fx = "echo"})
            local r = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(c.X, c.Y),
                Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 102}, ov)
            corner(r, UDim.new(1, 0))
            local st = stroke(r, C.lav, 4, 0)
            tw(r, 1.1, {Size = UDim2.fromOffset(maxSize, maxSize)}, Enum.EasingStyle.Quart)
            tw(st, 1.1, {Transparency = 1, Thickness = 1})
            task.delay(1.2, function() r:Destroy() end)
        end)
    end
    local function diamond(delay, maxSize, col)
        task.delay(delay, function()
            if not ov.Parent then return end
            local c = lcenter()
            local baseSpd = (1.05 + (maxSize - 380) / 360 * 0.65) * (col == C.mag and 1.15 or 1)
            hit("shing", baseSpd, 0.42, {fx = "shimmer"})
            hit("chime", math.min(2.4, baseSpd * 1.12), 0.34, {fx = "echo"})
            local d = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(c.X, c.Y),
                Size = UDim2.fromOffset(30, 30), Rotation = 45, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 102}, ov)
            local st = stroke(d, col, 3, 0.1)
            tw(d, 1.3, {Size = UDim2.fromOffset(maxSize, maxSize), Rotation = 45 + rnd(-90, 90)}, Enum.EasingStyle.Quart)
            tw(st, 1.3, {Transparency = 1, Thickness = 1})
            task.delay(1.4, function() d:Destroy() end)
        end)
    end
    local function burst(n)
        local c = lcenter()
        for i = 1, n do
            local a = rnd() * math.pi * 2
            local dist = vp.Y * 0.25 + rnd() * vp.Y * 0.35
            local sz = rnd(3, 9)
            local p = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(c.X, c.Y),
                Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = (i % 3 == 0) and C.txt or ((i % 2 == 0) and C.mag or C.lav),
                BorderSizePixel = 0, Rotation = rnd(0, 90), ZIndex = 108}, ov)
            corner(p, UDim.new(0.25, 0))
            local dur = 0.7 + rnd() * 0.6
            tw(p, dur, {Position = UDim2.fromOffset(c.X + math.cos(a) * dist, c.Y + math.sin(a) * dist),
                Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Rotation = p.Rotation + rnd(90, 270)}, Enum.EasingStyle.Quart)
            task.delay(dur + 0.1, function() p:Destroy() end)
        end
    end
    local function tintV(a, b, col)
        for _, bl in ipairs({a, b}) do
            local g = bl:FindFirstChildOfClass("UIGradient")
            if g then g.Color = ColorSequence.new(col) end
            bl.BackgroundTransparency = 0.4
        end
    end
    local function shiftV(a, b, dx)
        for _, bl in ipairs({a, b}) do
            bl.Position = UDim2.new(bl.Position.X.Scale, bl.Position.X.Offset + dx, bl.Position.Y.Scale, bl.Position.Y.Offset)
        end
    end
    local function glitch()
        if not ov.Parent or logo.Parent ~= stage then return end
        -- crisp cyber system error / digital stutter (zero vocals)
        errBuzz(0.56, 0.38 + rnd() * 0.12)
        hit("spark", 2.3 + rnd() * 0.4, 0.42, {fx = "err"})
        task.delay(0.04, function()
            errBuzz(0.42, 0.56 + rnd() * 0.14)
            hit("ping", 2.4 + rnd() * 0.35, 0.32, {fx = "err"})
        end)
        task.delay(0.085, function()
            hit("click", 0.68, 0.45, {fx = "err"})
        end)
        local a1, a2 = makeV(logo, 100, 105)
        local b1, b2 = makeV(logo, 100, 105)
        tintV(a1, a2, Color3.fromRGB(56, 189, 248))
        shiftV(a1, a2, -6)
        tintV(b1, b2, C.mag)
        shiftV(b1, b2, 6)
        task.delay(0.08, function()
            for _, o in ipairs({a1, a2, b1, b2}) do o:Destroy() end
        end)
    end

    task.spawn(function()
        local t0 = os.clock()
        while ov.Parent and os.clock() - t0 < 4.2 do
            local y = rnd()
            local f = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(-0.3, 0, y, 0),
