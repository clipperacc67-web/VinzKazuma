do
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local function visible(part, char)
        params.FilterDescendantsInstances = {LP.Character, Camera}
        local origin = Camera.CFrame.Position
        local r = Workspace:Raycast(origin, part.Position - origin, params)
        return r == nil or r.Instance:IsDescendantOf(char)
    end

    local function bestTarget()
        local vp = Camera.ViewportSize
        local center = Vector2.new(vp.X / 2, vp.Y / 2)
        local best, bestD = nil, S.fovR
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and isAlive(p) and not sameTeam(p) then
                local char = p.Character
                local part = char:FindFirstChild(S.aimPart) or char:FindFirstChild("HumanoidRootPart")
                if part then
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < bestD and (not S.wallCheck or visible(part, char)) then
                            best, bestD = part, d
                        end
                    end
                end
            end
        end
        return best
    end

    pcall(function() RunService:UnbindFromRenderStep("VK_Aim") end)
    RunService:BindToRenderStep("VK_Aim", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if not S.aim then return end
        local t = bestTarget()
        if not t then return end
        local cf = Camera.CFrame
        local goal = CFrame.lookAt(cf.Position, t.Position)
        local base = 1 / (1 + S.aimSmooth / 5)
        local a = 1 - (1 - base) ^ (dt * 60)
        Camera.CFrame = cf:Lerp(goal, math.clamp(a, 0.01, 1))
    end)
end

-- ---------- hitbox expander
do
    local orig = setmetatable({}, {__mode = "k"})
    local function restore()
        for part, o in pairs(orig) do
            if part.Parent then
                pcall(function()
                    part.Size = o.Size
                    part.Transparency = o.Tr
                    part.Material = o.Mat
                    part.Color = o.Col
                    part.CanCollide = o.CC
                    part.Massless = o.Ml
                end)
            end
            orig[part] = nil
        end
    end
    F.hbRestore = restore
    onUnload(restore)

    track(RunService.Heartbeat:Connect(function()
        if not S.hit then return end
        local sz = Vector3.new(S.hitSize, S.hitSize, S.hitSize)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and not sameTeam(p) then
                local part = hrpOf(p)
                if part then
                    if not orig[part] then
                        orig[part] = {Size = part.Size, Tr = part.Transparency, Mat = part.Material,
                            Col = part.Color, CC = part.CanCollide, Ml = part.Massless}
                    end
                    if part.Size ~= sz then part.Size = sz end
                    part.Transparency = S.hitTr
                    part.Material = Enum.Material.Neon
                    part.Color = C.neon
                    part.CanCollide = false
                    part.Massless = true
                end
            end
        end
    end))
end

-- ---------- auto clicker (Play Store style: draggable numbered touch points + control bar)
do
    local acc, total, cur, touchId = 0, 0, 1, 0
    local VIM
    pcall(function() VIM = game:GetService("VirtualInputManager") end)
    local pts = {}
    local running = false

    local function addPoint()
        local vp = Camera.ViewportSize
        local n = #pts + 1
        local m = new("Frame", {Name = "VKPoint", AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(vp.X / 2 + (n - 1) * 56, vp.Y / 2), Size = UDim2.fromOffset(48, 48),
            BackgroundColor3 = C.violet, BackgroundTransparency = running and 0.7 or 0.35, BorderSizePixel = 0,
            Active = not running, Visible = S.clickOverlay, ZIndex = 70}, Gui)
        corner(m, UDim.new(1, 0))
        stroke(m, C.lav, 2, 0)
        local lb = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = tostring(n),
            TextColor3 = C.txt, Font = Enum.Font.GothamBlack, TextSize = 18, ZIndex = 71}, m)
        makeDraggable(m, m)
        pts[n] = {f = m, lb = lb}
    end
    local function removePoint()
        local p = table.remove(pts)
        if p then p.f:Destroy() end
        cur = 1
    end
    F.clickAdd, F.clickDel = addPoint, removePoint

    local bar = new("Frame", {Name = "VKClickBar", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70),
        Size = UDim2.fromOffset(190, 56), BackgroundColor3 = C.card, BackgroundTransparency = 0.05, BorderSizePixel = 0,
        Active = true, Visible = false, ZIndex = 72}, Gui)
    corner(bar, UDim.new(0, 12))
    stroke(bar, C.lav, 1.5, 0.2)
    new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Text = ". . .", TextColor3 = C.muted,
        Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 73}, bar)
    makeDraggable(bar, bar)
    local function bbtn(txt, x, w)
        local b = new("TextButton", {Position = UDim2.fromOffset(x, 18), Size = UDim2.fromOffset(w, 32), BackgroundColor3 = C.violet,
            Text = txt, TextColor3 = C.txt, Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false, ZIndex = 73}, bar)
        corner(b, UDim.new(0, 8))
        return b
    end
    local startB = bbtn("START", 6, 70)
    local addB, subB, hideB = bbtn("+", 82, 32), bbtn("-", 118, 32), bbtn("x", 154, 30)
    startB.Activated:Connect(function()
        F.sfx()
        if S.click then F.clickStop() else F.clickStart() end
    end)
    addB.Activated:Connect(function() F.sfx() addPoint() end)
    subB.Activated:Connect(function() F.sfx() removePoint() end)
    hideB.Activated:Connect(function() F.sfx() if F.overlayOff then F.overlayOff() end end)

    F.clickView = function(v)
        bar.Visible = v
        if v and #pts == 0 then addPoint() end
        for _, p in ipairs(pts) do p.f.Visible = v end
    end
    F.clickRun = function(v)
        running = v
        startB.Text = v and "STOP" or "START"
        startB.BackgroundColor3 = v and C.mag or C.violet
        for _, p in ipairs(pts) do
            p.f.Active = not v
            p.f.BackgroundTransparency = v and 0.7 or 0.35
        end
        cur = 1
    end

    local function sendTap(x, y)
        local hold = S.clickHold / 1000
        if S.clickMode == "Touch Points" and VIM then
            touchId += 1
            local id = 9000 + touchId % 50
            if pcall(function() VIM:SendTouchEvent(id, 0, x, y) end) then
                task.delay(hold, function() pcall(function() VIM:SendTouchEvent(id, 2, x, y) end) end)
                return
            end
        end
        if VIM and pcall(function() VIM:SendMouseButtonEvent(x, y, 0, true, game, 0) end) then
            task.delay(hold, function() pcall(function() VIM:SendMouseButtonEvent(x, y, 0, false, game, 0) end) end)
            return
        end
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(x, y), Camera.CFrame)
        end)
    end

    local function toolClick()
        local ch = LP.Character
        local tool = ch and ch:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) return end
        if mouse1click then pcall(mouse1click) return end
        local vp = Camera.ViewportSize
        sendTap(vp.X / 2, vp.Y / 2)
    end

    local function tapNext()
        if S.clickMode == "Tool / Cursor" then toolClick() return true end
        if #pts == 0 then return false end
        if cur > #pts then cur = 1 end
        local p = pts[cur]
        cur = cur % #pts + 1
        local c = p.f.AbsolutePosition + p.f.AbsoluteSize / 2
        local j = S.clickJit
        if j > 0 then c = c + Vector2.new(math.random(-j, j), math.random(-j, j)) end
        sendTap(c.X, c.Y)
        p.f.BackgroundTransparency = 0.05
        tw(p.f, 0.25, {BackgroundTransparency = 0.7})
        return true
    end

    F.clickReset = function() acc, total, cur = 0, 0, 1 end

    track(RunService.Heartbeat:Connect(function(dt)
        if not S.click then acc = 0 return end
        acc += dt
        local iv = 1 / math.max(S.cps, 1)
        local guard = 0
        while acc >= iv and guard < 8 do
            acc -= iv
            guard += 1
            for _ = 1, S.clickN do
                if S.clickMax > 0 and total >= S.clickMax then break end
                if tapNext() == false then
                    F.clickStop()
                    notify("Add a point first (+ button)")
                    return
                end
                total += 1
            end
            if S.clickMax > 0 and total >= S.clickMax then
                F.clickStop()
                notify("Auto clicker finished: " .. total .. " taps")
                return
            end
        end
        if guard >= 8 then acc = 0 end
    end))
end

-- ---------- fly 1: Smooth Analog Fly (3D full camera orientation: up, down, anywhere)
do
    local bv, bg
    local function stop()
        if bv then bv:Destroy() bv = nil end
        if bg then bg:Destroy() bg = nil end
        local hum = humOf(LP)
        if hum then hum.PlatformStand = false end
    end
    F.flyStop = stop
    onUnload(stop)

    track(RunService.Heartbeat:Connect(function()
        if not S.fly then return end
        local hrp, hum = hrpOf(LP), humOf(LP)
        if not (hrp and hum) then return end
        if not bv or bv.Parent ~= hrp then
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
            bv = new("BodyVelocity", {MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero}, hrp)
            bg = new("BodyGyro", {MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 1e5, D = 1e3, CFrame = hrp.CFrame}, hrp)
        end
        hum.PlatformStand = true
        local cf = Camera.CFrame
        local look, right, up = cf.LookVector, cf.RightVector, cf.UpVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        flatLook = flatLook.Magnitude > 1e-3 and flatLook.Unit or Vector3.new(0, 0, -1)
        local flatRight = Vector3.new(right.X, 0, right.Z)
        flatRight = flatRight.Magnitude > 1e-3 and flatRight.Unit or Vector3.new(1, 0, 0)
        local md = hum.MoveDirection
        local f, r = md:Dot(flatLook), md:Dot(flatRight)
        local vel = look * f + right * r
        if hum.Jump or UIS:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vel -= Vector3.new(0, 1, 0) end
        if vel.Magnitude > 1 then vel = vel.Unit end
        bv.Velocity = vel * S.flySpeed
        -- Character faces full 3D front camera direction (can pitch straight up or straight down)
        bg.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + look, up)
    end))
end

-- ---------- fly 2: Fly + Animation (Invincible-style R15/R6 flight adapted for Android analog)
do
    local FA = {
        bv = nil,
        bg = nil,
        curVel = Vector3.zero,
        bank = 0,
        lastYaw = nil,
        animScript = nil,
        wasAnimDisabled = false,
        t = 0,
        active = false,
    }

    local function stopAnimTracks(hum)
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
                pcall(function() tr:Stop(0.1) end)
            end
        end
    end

    local function restoreAnimate()
        if FA.animScript and FA.animScript.Parent then
            pcall(function() FA.animScript.Disabled = FA.wasAnimDisabled end)
        end
        FA.animScript = nil
    end

    local function stop()
        FA.active = false
        FA.curVel = Vector3.zero
        FA.bank = 0
        FA.lastYaw = nil
        if FA.bv then FA.bv:Destroy() FA.bv = nil end
        if FA.bg then FA.bg:Destroy() FA.bg = nil end
        restoreAnimate()
        local hum = humOf(LP)
        if hum then
            hum.PlatformStand = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
    end
    F.flyAnimStop = stop
    onUnload(stop)

    -- Physics & orientation driver
    track(RunService.RenderStepped:Connect(function(dt)
        if not S.flyAnim then return end
        local ch = LP.Character
        local hrp, hum = hrpOf(LP), humOf(LP)
        if not (ch and hrp and hum) then return end

        FA.active = true
        FA.t += dt

        local anim = ch:FindFirstChild("Animate")
        if anim and anim ~= FA.animScript then
            restoreAnimate()
            FA.animScript = anim
            FA.wasAnimDisabled = anim.Disabled
            pcall(function() anim.Disabled = true end)
            stopAnimTracks(hum)
        end

        if not FA.bv or FA.bv.Parent ~= hrp then
            if FA.bv then FA.bv:Destroy() end
            if FA.bg then FA.bg:Destroy() end
            FA.bv = new("BodyVelocity", {MaxForce = Vector3.new(9e9, 9e9, 9e9), Velocity = Vector3.zero}, hrp)
            FA.bg = new("BodyGyro", {MaxTorque = Vector3.new(9e9, 9e9, 9e9), P = 28000, D = 650, CFrame = hrp.CFrame}, hrp)
        end

        hum.PlatformStand = true
        local cf = Camera.CFrame
        local look, right = cf.LookVector, cf.RightVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        flatLook = flatLook.Magnitude > 1e-3 and flatLook.Unit or Vector3.new(0, 0, -1)
        local flatRight = Vector3.new(right.X, 0, right.Z)
        flatRight = flatRight.Magnitude > 1e-3 and flatRight.Unit or Vector3.new(1, 0, 0)

        -- Android analog thumbstick input projected onto 3D front camera direction
        local md = hum.MoveDirection
        local f, r = md:Dot(flatLook), md:Dot(flatRight)
        local inputVec = look * f + right * r
        if hum.Jump or UIS:IsKeyDown(Enum.KeyCode.Space) then inputVec += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then inputVec -= Vector3.new(0, 1, 0) end
        if inputVec.Magnitude > 1 then inputVec = inputVec.Unit end

        local targetVel = inputVec * S.flySpeed
        FA.curVel = FA.curVel:Lerp(targetVel, math.clamp(dt * 8.5, 0, 1))

        local spdRatio = math.clamp(FA.curVel.Magnitude / math.max(S.flySpeed, 1), 0, 1)

        -- Camera yaw turn rate + strafe roll for smooth superhero banking
        local _, camYaw, _ = cf:ToOrientation()
        local yawDelta = 0
        if FA.lastYaw then
            yawDelta = math.atan2(math.sin(camYaw - FA.lastYaw), math.cos(camYaw - FA.lastYaw))
        end
        FA.lastYaw = camYaw
        local targetBank = math.clamp((-r * 0.55) + (yawDelta / math.max(dt, 1 / 120)) * 0.18, -0.75, 0.75) * spdRatio
        FA.bank += (targetBank - FA.bank) * math.clamp(dt * 10, 0, 1)

        if spdRatio > 0.08 then
            FA.bv.Velocity = FA.curVel
            local flyDir = FA.curVel.Unit
            local upRef = math.abs(flyDir.Y) > 0.96 and cf.UpVector or Vector3.yAxis
            local faceCF = CFrame.lookAt(hrp.Position, hrp.Position + flyDir, upRef)
            -- Invincible horizontal dive pitch (-82 deg at full speed) + banking roll
            FA.bg.CFrame = faceCF * CFrame.Angles(math.rad(-82 * spdRatio), 0, FA.bank)
        else
            -- Upright Invincible hover pose with subtle breathing float
            FA.bv.Velocity = Vector3.new(0, math.cos(FA.t * 2.4) * 1.1, 0)
            local hoverCF = CFrame.lookAt(hrp.Position, hrp.Position + flatLook, Vector3.yAxis)
            FA.bg.CFrame = hoverCF * CFrame.Angles(math.rad(-6 + math.sin(FA.t * 2.2) * 2.5), 0, math.sin(FA.t * 1.7) * 0.04)
        end
    end))

    -- Procedural Invincible joint posing on Stepped (overrides Motor6D.Transform cleanly without breaking C0/C1)
    track(RunService.Stepped:Connect(function()
        if not S.flyAnim or not FA.active then return end
        local ch = LP.Character
        if not ch then return end
        local spdRatio = math.clamp(FA.curVel.Magnitude / math.max(S.flySpeed, 1), 0, 1)
        local t = FA.t
        local flutter = math.sin(t * 14) * 0.03 * spdRatio
        local breathe = math.sin(t * 2.5) * 0.05 * (1 - spdRatio)

        -- R15 joints
        local upperTorso = ch:FindFirstChild("UpperTorso")
        local head = ch:FindFirstChild("Head")
        local rUpperArm = ch:FindFirstChild("RightUpperArm")
        local lUpperArm = ch:FindFirstChild("LeftUpperArm")
        local rLowerArm = ch:FindFirstChild("RightLowerArm")
        local lLowerArm = ch:FindFirstChild("LeftLowerArm")
        local rUpperLeg = ch:FindFirstChild("RightUpperLeg")
        local lUpperLeg = ch:FindFirstChild("LeftUpperLeg")
        local rLowerLeg = ch:FindFirstChild("RightLowerLeg")
        local lLowerLeg = ch:FindFirstChild("LeftLowerLeg")

        if upperTorso and head and rUpperArm and lUpperArm then
            local waist = upperTorso:FindFirstChild("Waist")
            local neck = head:FindFirstChild("Neck")
            local rSh = rUpperArm:FindFirstChild("RightShoulder")
            local lSh = lUpperArm:FindFirstChild("LeftShoulder")
            local rEl = rLowerArm and rLowerArm:FindFirstChild("RightElbow")
            local lEl = lLowerArm and lLowerArm:FindFirstChild("LeftElbow")
            local rHip = rUpperLeg and rUpperLeg:FindFirstChild("RightHip")
            local lHip = lUpperLeg and lUpperLeg:FindFirstChild("LeftHip")
            local rKnee = rLowerLeg and rLowerLeg:FindFirstChild("RightKnee")
            local lKnee = lLowerLeg and lLowerLeg:FindFirstChild("LeftKnee")

            -- Chest arch + head pitched up (+68 deg) so Invincible looks forward while flying horizontally
            if waist then waist.Transform = CFrame.Angles(math.rad(14 * spdRatio), 0, -FA.bank * 0.25) end
            if neck then neck.Transform = CFrame.Angles(math.rad(68 * spdRatio - 4 * (1 - spdRatio)), 0, -FA.bank * 0.45) end

            -- Right fist forward + left arm swept back in flight; relaxed hover arms when idle
            if rSh then
                local pitch = math.rad(158 * spdRatio + 4 * (1 - spdRatio))
                local roll = math.rad(-8 * spdRatio - 18 * (1 - spdRatio)) - breathe
                rSh.Transform = CFrame.Angles(pitch, 0, roll)
            end
            if lSh then
                local pitch = math.rad(-32 * spdRatio + 4 * (1 - spdRatio))
                local roll = math.rad(14 * spdRatio + 18 * (1 - spdRatio)) + breathe + flutter
                lSh.Transform = CFrame.Angles(pitch, 0, roll)
            end
            if rEl then rEl.Transform = CFrame.Angles(math.rad(6 * spdRatio + 16 * (1 - spdRatio)), 0, 0) end
            if lEl then lEl.Transform = CFrame.Angles(math.rad(22 * spdRatio + 16 * (1 - spdRatio)), 0, 0) end

            -- Superhero hover bent right knee vs streamlined straight flight legs
            if rHip then rHip.Transform = CFrame.Angles(math.rad(34 * (1 - spdRatio) - 4 * spdRatio) + flutter, 0, math.rad(-4)) end
            if lHip then lHip.Transform = CFrame.Angles(math.rad(6 * (1 - spdRatio) - 4 * spdRatio) - flutter, 0, math.rad(4)) end
            if rKnee then rKnee.Transform = CFrame.Angles(math.rad(-58 * (1 - spdRatio) - 4 * spdRatio), 0, 0) end
            if lKnee then lKnee.Transform = CFrame.Angles(math.rad(-10 * (1 - spdRatio) - 4 * spdRatio), 0, 0) end
        else
            -- R6 fallback joints
            local torso = ch:FindFirstChild("Torso")
            if torso then
                local neck = torso:FindFirstChild("Neck")
                local rSh = torso:FindFirstChild("Right Shoulder")
                local lSh = torso:FindFirstChild("Left Shoulder")
                local rHip = torso:FindFirstChild("Right Hip")
                local lHip = torso:FindFirstChild("Left Hip")
                if neck then neck.Transform = CFrame.Angles(math.rad(-62 * spdRatio), 0, 0) end
                if rSh then rSh.Transform = CFrame.Angles(0, 0, math.rad(155 * spdRatio + 18 * (1 - spdRatio))) end
                if lSh then lSh.Transform = CFrame.Angles(0, 0, math.rad(28 * spdRatio - 18 * (1 - spdRatio))) end
                if rHip then rHip.Transform = CFrame.Angles(0, 0, math.rad(-32 * (1 - spdRatio))) end
                if lHip then lHip.Transform = CFrame.Angles(0, 0, math.rad(8 * (1 - spdRatio))) end
            end
        end
    end))
end

