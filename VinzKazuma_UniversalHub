-- ---------- FPS boost (flat materials, no shadows / effects / particles / decals, lowest quality level)
do
    local FB = {bk = nil, parts = setmetatable({}, {__mode = "k"}), misc = setmetatable({}, {__mode = "k"}), gen = 0, conn = nil}
    local EFX = {BloomEffect = true, BlurEffect = true, SunRaysEffect = true, DepthOfFieldEffect = true, ColorCorrectionEffect = true}
    local EMIT = {ParticleEmitter = true, Trail = true, Smoke = true, Fire = true, Sparkles = true, Beam = true}

    local function lite(d)
        if FB.parts[d] or FB.misc[d] then return end
        if d:IsA("BasePart") then
            if d:IsA("Terrain") or isCharPart(d) then return end
            local o = {Mat = d.Material, Rf = d.Reflectance, Cs = d.CastShadow}
            if d:IsA("MeshPart") then o.Fid = d.RenderFidelity end
            FB.parts[d] = o
            pcall(function()
                d.Material = Enum.Material.SmoothPlastic
                d.Reflectance = 0
                d.CastShadow = false
                if o.Fid then d.RenderFidelity = Enum.RenderFidelity.Performance end
            end)
        elseif EMIT[d.ClassName] then
            FB.misc[d] = {Enabled = d.Enabled}
            pcall(function() d.Enabled = false end)
        elseif d:IsA("Decal") and not isCharPart(d) then
            FB.misc[d] = {Transparency = d.Transparency}
            pcall(function() d.Transparency = 1 end)
        end
    end

    local function enable()
        if FB.bk then return end
        local T = Workspace.Terrain
        local bk = {L = {}, T = {}, fx = {}}
        for _, p in ipairs({"GlobalShadows", "Technology", "ShadowSoftness"}) do bk.L[p] = getProp(Lighting, p) end
        for _, p in ipairs({"WaterWaveSize", "WaterReflectance", "Decoration"}) do bk.T[p] = getProp(T, p) end
        pcall(function() bk.q = settings().Rendering.QualityLevel end)
        FB.bk = bk

        setProp(Lighting, "GlobalShadows", false)
        setProp(Lighting, "Technology", Enum.Technology.Compatibility)
        for _, e in ipairs(Lighting:GetChildren()) do
            if EFX[e.ClassName] and e.Enabled then
                bk.fx[e] = true
                pcall(function() e.Enabled = false end)
            end
        end
        setProp(T, "WaterWaveSize", 0)
        setProp(T, "WaterReflectance", 0)
        setProp(T, "Decoration", false)
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

        FB.gen += 1
        local gen = FB.gen
        FB.conn = Workspace.DescendantAdded:Connect(function(d) pcall(lite, d) end)
        task.spawn(function()
            local n = 0
            for _, d in ipairs(Workspace:GetDescendants()) do
                if FB.gen ~= gen or not Alive then return end
                n += 1
                if n % 300 == 0 then task.wait() end
                pcall(lite, d)
            end
        end)
    end

    local function restoreAll(gen, sync)
        local plist, mlist = {}, {}
        for p in pairs(FB.parts) do plist[#plist + 1] = p end
        for m in pairs(FB.misc) do mlist[#mlist + 1] = m end
        for i, p in ipairs(plist) do
            if not sync and FB.gen ~= gen then return end
            local o = FB.parts[p]
            if p.Parent and o then
                pcall(function()
                    p.Material = o.Mat
                    p.Reflectance = o.Rf
                    p.CastShadow = o.Cs
                    if o.Fid then p.RenderFidelity = o.Fid end
                end)
            end
            FB.parts[p] = nil
            if not sync and i % 300 == 0 then task.wait() end
        end
        for i, m in ipairs(mlist) do
            if not sync and FB.gen ~= gen then return end
            local o = FB.misc[m]
            if m.Parent and o then
                for k, v in pairs(o) do pcall(function() m[k] = v end) end
            end
            FB.misc[m] = nil
            if not sync and i % 300 == 0 then task.wait() end
        end
    end

    local function disable(sync)
        local bk = FB.bk
        if not bk then return end
        FB.bk = nil
        FB.gen += 1
        local gen = FB.gen
        if FB.conn then FB.conn:Disconnect() FB.conn = nil end
        for p, v in pairs(bk.L) do if v ~= nil then setProp(Lighting, p, v) end end
        for p, v in pairs(bk.T) do if v ~= nil then setProp(Workspace.Terrain, p, v) end end
        for e in pairs(bk.fx) do if e.Parent then pcall(function() e.Enabled = true end) end end
        if bk.q then pcall(function() settings().Rendering.QualityLevel = bk.q end) end
        if sync then restoreAll(gen, true) else task.spawn(function() restoreAll(gen, false) end) end
    end

    F.fpsToggle = function(v) if v then enable() else disable(false) end end
    onUnload(function() disable(true) end)
end

