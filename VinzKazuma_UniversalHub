        Text = "", AutoButtonColor = false}, f)

    local function render()
        local a = math.clamp((S[key] - mn) / (mx - mn), 0, 1)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        local v = S[key]
        if fmt == "%d" then v = math.floor(v + 0.5) end
        val.Text = string.format(fmt, v)
    end
    local function setFromX(x)
        local a = math.clamp((x - track_.AbsolutePosition.X) / math.max(track_.AbsoluteSize.X, 1), 0, 1)
        local v = mn + (mx - mn) * a
        v = math.clamp(math.floor(v / step + 0.5) * step, mn, mx)
        S[key] = v
        render()
        if cb then cb(v) end
    end
    local dragging = false
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            F.sfx()
            page.ScrollingEnabled = false
            setFromX(input.Position.X)
            local ch
            ch = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    ch:Disconnect()
                    dragging = false
                    page.ScrollingEnabled = true
                end
            end)
        end
    end)
    hit.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    render()
end

local function Stepper(page, text, key, mn, mx, step, cb, fmt)
    fmt = fmt or "%d"
    local f = row(page, 44)
    new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -140, 1, 0),
        Text = text, TextColor3 = C.txt, Font = Enum.Font.GothamMedium, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true}, f)
    local function mk(sym, xoff)
        local b = new("TextButton", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xoff, 0.5, 0),
            Size = UDim2.fromOffset(32, 30), BackgroundColor3 = C.violet, Text = sym, TextColor3 = C.txt,
            Font = Enum.Font.GothamBold, TextSize = 18, AutoButtonColor = false}, f)
        corner(b, UDim.new(0, 8))
        return b
    end
    local plus, minus = mk("+", -10), mk("-", -92)
    local val = new("TextLabel", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -46, 0.5, 0),
        Size = UDim2.fromOffset(42, 30), BackgroundTransparency = 1, Text = "", TextColor3 = C.lav,
        Font = Enum.Font.GothamBold, TextSize = 13}, f)

    local function render()
        local v = S[key]
        val.Text = type(fmt) == "function" and fmt(v) or string.format(fmt, v)
    end
    local function bump(d)
        S[key] = math.clamp(S[key] + d * step, mn, mx)
        render()
        if cb then cb(S[key]) end
    end
    local function hook(btn, d)
        btn.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local held = true
            local ch
            ch = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    held = false
                    ch:Disconnect()
                end
            end)
            F.sfx()
            bump(d)
            task.spawn(function()
                task.wait(0.4)
                while held and Alive and btn.Parent do
                    bump(d)
                    task.wait(0.07)
                end
            end)
        end)
    end
    hook(plus, 1)
    hook(minus, -1)
    render()
end

