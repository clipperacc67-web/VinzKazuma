-- ---------- sound effects: F.sfx(id, speed, vol) + clean non-vocal DSP F.introSfx(id, speed, vol, opts) for intro loading.
do
    local SoundService = game:GetService("SoundService")
    local ids = {
        click  = "12221967",   -- classic Roblox UI click (universal public)
        intro  = "2865227271", -- clean synth chime (universal public)
        whoosh = "12222216",   -- classic Roblox blade slash/whoosh (universal public)
        lunge  = "12222208",   -- classic Roblox energy sweep (universal public)
        shing  = "12222225",   -- classic Roblox metallic ring (universal public)
        ping   = "12221976",   -- classic Roblox electronic cyber ping (universal public)
        chime  = "4590662766", -- futuristic UI ding/chime (auto-fallback if restricted)
        spark  = "6895079853", -- crisp tech tick/sparkle (auto-fallback if restricted)
    }
    local fallback = {
        chime = "intro",
        spark = "ping",
    }
    local warm, warmByKey, loadedOk, ready = {}, {}, {}, false
    for k, id in pairs(ids) do
        local w = Instance.new("Sound")
        w.SoundId = "rbxassetid://" .. id
        w.Volume = 0
        w.Parent = SoundService
        warm[#warm + 1] = w
        warmByKey[k] = w
    end
    onUnload(function() for _, w in ipairs(warm) do pcall(function() w:Destroy() end) end end)
    -- preload so every intro SFX plays on-beat with zero lag, and verify asset availability
    task.spawn(function()
        pcall(function() game:GetService("ContentProvider"):PreloadAsync(warm) end)
        for k, w in pairs(warmByKey) do
            local ok, len = pcall(function() return w.IsLoaded and w.TimeLength > 0 end)
            loadedOk[k] = ok and len
        end
        ready = true
    end)
    F.sfxWait = function(maxT)
        local t0 = os.clock()
        while not ready and os.clock() - t0 < (maxT or 1.5) do task.wait() end
    end
    local function resolveId(key)
        local k = key or "click"
        if ids[k] then
            if fallback[k] and not loadedOk[k] then
                return ids[fallback[k]]
            end
            return ids[k]
        end
        return tostring(k)
    end
    local function applyFx(snd, preset)
        if not preset then return end
        if preset == "sub" then
            new("EqualizerSoundEffect", {HighGain = -80, MidGain = -24, LowGain = 10}, snd)
            new("DistortionSoundEffect", {Level = 0.28}, snd)
            new("ReverbSoundEffect", {DecayTime = 1.8, Density = 0.85, WetLevel = -4, DryLevel = 0}, snd)
        elseif preset == "space" then
            new("ReverbSoundEffect", {DecayTime = 2.6, Density = 0.9, WetLevel = -2, DryLevel = -2}, snd)
            new("ChorusSoundEffect", {Depth = 0.42, Mix = 0.45, Rate = 1.6}, snd)
        elseif preset == "echo" then
            new("EchoSoundEffect", {Delay = 0.13, Feedback = 0.42, WetLevel = -4, DryLevel = 0}, snd)
            new("ReverbSoundEffect", {DecayTime = 1.2, WetLevel = -6, DryLevel = 0}, snd)
        elseif preset == "err" then
            new("DistortionSoundEffect", {Level = 0.72}, snd)
            new("EqualizerSoundEffect", {HighGain = 3, MidGain = 6, LowGain = -10}, snd)
            new("FlangerSoundEffect", {Depth = 0.8, Mix = 0.65, Rate = 12}, snd)
            new("TremoloSoundEffect", {Depth = 0.75, Duty = 0.5, Frequency = 20}, snd)
        elseif preset == "whoosh" then
            new("FlangerSoundEffect", {Depth = 0.65, Mix = 0.55, Rate = 4.5}, snd)
            new("ReverbSoundEffect", {DecayTime = 1.4, WetLevel = -4, DryLevel = 0}, snd)
        elseif preset == "shimmer" then
            new("ChorusSoundEffect", {Depth = 0.5, Mix = 0.5, Rate = 2.8}, snd)
            new("EchoSoundEffect", {Delay = 0.085, Feedback = 0.48, WetLevel = -3, DryLevel = 0}, snd)
            new("EqualizerSoundEffect", {HighGain = 7, MidGain = 1, LowGain = -8}, snd)
        elseif preset == "punch" then
            new("EqualizerSoundEffect", {HighGain = 4, MidGain = 3, LowGain = 8}, snd)
            new("ReverbSoundEffect", {DecayTime = 0.9, WetLevel = -7, DryLevel = 0}, snd)
        end
    end
    F.sfx = function(id, speed, vol)
        pcall(function()
            local snd = Instance.new("Sound")
            snd.SoundId = "rbxassetid://" .. (ids[id or "click"] or id)
            snd.PlaybackSpeed = speed or 1
            snd.Volume = vol or 1
            snd.Parent = SoundService
            snd:Play()
            snd.Ended:Connect(function() snd:Destroy() end)
            task.delay(6, function() if snd.Parent then snd:Destroy() end end)
        end)
    end
    F.introSfx = function(id, speed, vol, opts)
        pcall(function()
            opts = opts or {}
            local snd = Instance.new("Sound")
            snd.SoundId = "rbxassetid://" .. resolveId(id)
            snd.PlaybackSpeed = speed or 1
            snd.Volume = vol or 1
            if opts.timePos then snd.TimePosition = opts.timePos end
            if opts.looped then snd.Looped = true end
            pcall(applyFx, snd, opts.fx)
            snd.Parent = SoundService
            snd:Play()
            if opts.toSpeed and opts.dur then
                tw(snd, opts.dur, {PlaybackSpeed = opts.toSpeed}, opts.style or Enum.EasingStyle.Quad, opts.dir or Enum.EasingDirection.Out)
            end
            if opts.fadeOut and opts.dur then
                task.delay(opts.fadeDelay or 0, function()
                    if snd.Parent then tw(snd, opts.dur, {Volume = 0}, Enum.EasingStyle.Quad, Enum.EasingDirection.In) end
                end)
            end
            local life = opts.life or 6
            snd.Ended:Connect(function() if snd.Parent then snd:Destroy() end end)
            task.delay(life, function() if snd.Parent then snd:Destroy() end end)
        end)
    end
end

