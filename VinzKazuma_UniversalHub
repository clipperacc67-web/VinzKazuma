-- drag helper (mouse + touch). onTap fires if the pointer barely moved.
local function makeDraggable(handle, target, onTap)
    local dragging, sIn, sPos, sFrame, moved = false, nil, nil, nil, false
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved, sIn, sPos, sFrame = true, false, input, input.Position, target.Position
            local ch
            ch = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    ch:Disconnect()
                    dragging = false
                    if not moved and onTap then onTap() end
                end
            end)
        end
    end)
    track(UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input == sIn or input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - sPos
            if d.Magnitude > 6 then moved = true end
            if moved then
                target.Position = UDim2.new(sFrame.X.Scale, sFrame.X.Offset + d.X, sFrame.Y.Scale, sFrame.Y.Offset + d.Y)
            end
        end
    end))
end

-- "V" logo made of two sharp blades. h = logo height in px.
local function makeV(parent, h, z)
    local bw, bh = h * 0.2, h * 0.8
    local off = (bh / 2) * math.sin(math.rad(22))
    local function blade(sign)
        local b = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, sign * off, 0.5, 0),
            Size = UDim2.fromOffset(bw, bh), Rotation = sign * 22, BackgroundColor3 = C.neon, BorderSizePixel = 0,
            ZIndex = z or 2}, parent)
        corner(b, UDim.new(0, math.max(2, bw * 0.28)))
        grad(b, C.lav, C.mag, 90)
        return b
    end
    return blade(-1), blade(1)
end

