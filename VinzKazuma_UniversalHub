-- ============================================================ lifecycle
local Alive = true
local Conns, Hooks = {}, {}
local Gui, EspFolder

local function track(c) Conns[#Conns + 1] = c return c end
local function onUnload(fn) Hooks[#Hooks + 1] = fn end

local function Unload()
    if not Alive then return end
    Alive = false
    for i = #Hooks, 1, -1 do pcall(Hooks[i]) end
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    pcall(function() RunService:UnbindFromRenderStep("VK_Aim") end)
    pcall(function() RunService:UnbindFromRenderStep("VK_Cam") end)
    if EspFolder then pcall(function() EspFolder:Destroy() end) end
    if Gui then pcall(function() Gui:Destroy() end) end
    if genv.__VK_CLEANUP == Unload then genv.__VK_CLEANUP = nil end
end
