	VK.new("TextLabel", {
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Font = VK.Font,
		TextSize = 12,
		TextColor3 = VK.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = 1,
		Text = text,
	}, box)
	TweenService:Create(box, TweenInfo.new(0.2), {BackgroundTransparency = 0.1}):Play()
	for _, d in pairs(box:GetDescendants()) do
		if d:IsA("TextLabel") then
			TweenService:Create(d, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
		end
	end
	task.delay(2.2, function()
		TweenService:Create(box, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play()
		for _, d in pairs(box:GetDescendants()) do
			if d:IsA("TextLabel") then
				TweenService:Create(d, TweenInfo.new(0.25), {TextTransparency = 1}):Play()
			end
		end
		task.wait(0.3)
		box:Destroy()
	end)
end

