		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	VK.new("TextLabel", {
		Size = UDim2.new(1, -20, 0, 14),
		Position = UDim2.new(0, 14, 0, 25),
		BackgroundTransparency = 1,
		Font = VK.Font,
		Text = desc,
		TextSize = 10,
		TextColor3 = VK.Dim,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local row = VK.new("Frame", {
		Size = UDim2.new(1, -28, 0, 22),
		Position = UDim2.new(0, 14, 1, -28),
		BackgroundTransparency = 1,
	}, card)
	VK.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, row)

	local ctrl = {value = default}
	local btns = {}
	for idx, opt in ipairs(options) do
		local b = VK.new("TextButton", {
			Size = UDim2.new(0, 74, 1, 0),
			BackgroundColor3 = VK.Card,
			Font = VK.Font,
			Text = opt,
			TextSize = 11,
			TextColor3 = VK.Dim,
			AutoButtonColor = false,
		}, row)
		b.LayoutOrder = idx
		VK.corner(b, 6)
		VK.stroke(b, VK.Border)
		btns[opt] = b
		b.MouseButton1Click:Connect(function()
			ctrl.value = opt
			for k, btn in pairs(btns) do
				btn.TextColor3 = (k == opt) and VK.Text or VK.Dim
				btn.BackgroundColor3 = (k == opt) and VK.Accent or VK.Card
			end
			if callback then VK.safe(function() callback(opt) end) end
		end)
	end
	if default and btns[default] then
		btns[default].TextColor3 = VK.Text
		btns[default].BackgroundColor3 = VK.Accent
	end
	return ctrl
end

