		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
	}, card)

	local ctrl = {value = false, callback = callback, sw = sw, knob = knob}

	function ctrl:set(state, silent)
		self.value = state
		VK.Flags[name] = state
		TweenService:Create(self.sw, TweenInfo.new(0.15), {
			BackgroundColor3 = state and VK.Accent or VK.Border,
		}):Play()
		TweenService:Create(self.knob, TweenInfo.new(0.15), {
			Position = state and UDim2.new(1, -20, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
			BackgroundColor3 = state and Color3.fromRGB(12, 12, 14) or Color3.fromRGB(200, 200, 208),
		}):Play()
		if not silent and self.callback then
			VK.safe(function() self.callback(state) end)
		end
	end

	click.MouseButton1Click:Connect(function()
		ctrl:set(not ctrl.value)
	end)

	ctrl:set(default or false, true)
	if default then ctrl:set(true, true) end
	return ctrl
end

function VK.makeSlider(page, name, desc, min, max, default, callback)
	local card = VK.makeCard(page, 66)
	card:SetAttribute("vkName", string.lower(name .. " " .. desc))

	local lbl = VK.new("TextLabel", {
		Size = UDim2.new(1, -80, 0, 18),
		Position = UDim2.new(0, 14, 0, 9),
		BackgroundTransparency = 1,
		Font = VK.FontBold,
		Text = name,
		TextSize = 13,
		TextColor3 = VK.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local valLbl = VK.new("TextLabel", {
		Size = UDim2.new(0, 60, 0, 18),
		Position = UDim2.new(1, -74, 0, 9),
		BackgroundTransparency = 1,
		Font = VK.FontBold,
		Text = tostring(default),
		TextSize = 12,
		TextColor3 = VK.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, card)

	VK.new("TextLabel", {
		Size = UDim2.new(1, -28, 0, 14),
		Position = UDim2.new(0, 14, 0, 26),
		BackgroundTransparency = 1,
		Font = VK.Font,
		Text = desc,
		TextSize = 10,
		TextColor3 = VK.Dim,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local bar = VK.new("Frame", {
		Size = UDim2.new(1, -28, 0, 4),
		Position = UDim2.new(0, 14, 1, -14),
		BackgroundColor3 = VK.Border,
		BorderSizePixel = 0,
	}, card)
	VK.corner(bar, 2)

	local fill = VK.new("Frame", {
		Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
		BackgroundColor3 = VK.Accent,
		BorderSizePixel = 0,
	}, bar)
	VK.corner(fill, 2)

	local dragBtn = VK.new("TextButton", {
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -23),
		BackgroundTransparency = 1,
		Text = "",
	}, card)

	local ctrl = {value = default}
	local dragging = false

	local function apply(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = math.floor((min + (max - min) * rel) + 0.5)
		ctrl.value = v
		fill.Size = UDim2.new(rel, 0, 1, 0)
		valLbl.Text = tostring(v)
		if callback then VK.safe(function() callback(v) end) end
	end

	dragBtn.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			apply(i.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			apply(i.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function()
		dragging = false
	end)

	VK.safe(function() if callback then callback(default) end end)
	return ctrl
end

