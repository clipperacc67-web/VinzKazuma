function VK.addNav(label, key, icon, sectionName)
	if sectionName then
		local s = VK.new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundTransparency = 1,
			Font = VK.FontBold,
			Text = string.upper(sectionName),
			TextSize = 9,
			TextColor3 = VK.Dim,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, sideScroll)
		s.LayoutOrder = #navButtons * 10
		local pad = Instance.new("UIPadding", s)
		pad.PaddingLeft = UDim.new(0, 6)
	end

	local btn = VK.new("TextButton", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = VK.Panel,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = VK.Font,
		Text = "  " .. label,
		TextSize = 12,
		TextColor3 = VK.Dim,
		TextXAlignment = Enum.TextXAlignment.Left,
		AutoButtonColor = false,
	}, sideScroll)
	btn.LayoutOrder = #navButtons * 10 + 1
	VK.corner(btn, 7)

	VK.new("TextLabel", {
		Size = UDim2.new(0, 22, 1, 0),
		Position = UDim2.new(0, 4, 0, 0),
		BackgroundTransparency = 1,
		Font = VK.FontBold,
		Text = icon,
		TextSize = 12,
		TextColor3 = VK.Dim,
	}, btn)

	local marker = VK.new("Frame", {
		Size = UDim2.new(0, 3, 0, 14),
		Position = UDim2.new(0, 0, 0.5, -7),
		BackgroundColor3 = VK.Accent,
		BorderSizePixel = 0,
		Visible = false,
	}, btn)

	table.insert(navButtons, {btn = btn, key = key, marker = marker})

	btn.MouseButton1Click:Connect(function()
		VK.showPage(key)
	end)
	return btn
end

function VK.showPage(key)
	for _, item in pairs(navButtons) do
		local on = item.key == key
		item.btn.TextColor3 = on and VK.Text or VK.Dim
		item.btn.BackgroundTransparency = on and 0.85 or 1
		item.btn.BackgroundColor3 = on and VK.Card or VK.Panel
		item.marker.Visible = on
	end
	for k, p in pairs(VK.Pages) do
		p.Visible = (k == key)
	end
	VK.CurrentPage = key
end

